# MongoDB Connection (REQUIRED)
MONGODB_URI=mongodb://localhost:27017/guestworker

# JWT Secret Key (REQUIRED - generate a secure random string for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# Admin Account (REQUIRED - Initial admin credentials)
# These are used to create the first admin account on server startup
# IMPORTANT: Change password immediately after first login
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisSecurePassword123!

# Cookie Security (Production: set to true when using HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Razorpay Keys (REQUIRED for payments - Production-ready)
# Get these from: Razorpay Dashboard > Settings > API Keys
# Use rzp_test_* for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Razorpay Webhook Secret (Optional but recommended)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# CORS Allowed Origins (REQUIRED - comma-separated)
# Production example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment
NODE_ENV=development
